$C = "../Common.ui";

@ColorNameStyle = (
  FontSize: 14,
  TextColor: $C.@ColorGrayCaption,
  VerticalAlignment: Center,
  HorizontalAlignment: Center
);

@ColorSwatch = Group {
  Anchor: (Width: 110, Height: 38, Bottom: 8);
  Background: #f9fffe;
};

@PreviewLabelStyle = (
  FontSize: 13,
  TextColor: $C.@ColorGrayCaption,
  HorizontalAlignment: Center
);

@ColorControlButtonAnchor = Anchor(Width: 124, Height: 42, Bottom: 8);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = "Ender Chest";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label {
        Text: "Network owner";
        Style: $C.@DefaultLabelStyle;
        Anchor: (Bottom: 4);
      }

      Label #NetworkOwner {
        Style: (
          FontSize: 14,
          TextColor: $C.@ColorDefaultLabel,
          Wrap: true
        );
        Anchor: (Bottom: 16);
      }

      Label {
        Text: "Color code preview";
        Style: $C.@DefaultLabelStyle;
        Anchor: (Bottom: 8);
      }

      Group {
        LayoutMode: Center;
        Anchor: (Bottom: 18);

        Group {
          LayoutMode: Top;
          Anchor: (Width: 132, Right: 12);

          Label {
            Text: "Left";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          Label #ColorOneName {
            Style: @ColorNameStyle;
            Anchor: (Height: 22, Bottom: 8);
          }

          $C.@TextButton #ColorOnePrevious {
            Text: "Previous";
            Anchor: @ColorControlButtonAnchor;
          }

          @ColorSwatch #LeftSwatch {}

          $C.@TextButton #ColorOneNext {
            Text: "Next";
            Anchor: @ColorControlButtonAnchor;
          }
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 132, Right: 12);

          Label {
            Text: "Center";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          Label #ColorTwoName {
            Style: @ColorNameStyle;
            Anchor: (Height: 22, Bottom: 8);
          }

          $C.@TextButton #ColorTwoPrevious {
            Text: "Previous";
            Anchor: @ColorControlButtonAnchor;
          }

          @ColorSwatch #CenterSwatch {}

          $C.@TextButton #ColorTwoNext {
            Text: "Next";
            Anchor: @ColorControlButtonAnchor;
          }
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 132);

          Label {
            Text: "Right";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          Label #ColorThreeName {
            Style: @ColorNameStyle;
            Anchor: (Height: 22, Bottom: 8);
          }

          $C.@TextButton #ColorThreePrevious {
            Text: "Previous";
            Anchor: @ColorControlButtonAnchor;
          }

          @ColorSwatch #RightSwatch {}

        $C.@TextButton #ColorThreeNext {
          Text: "Next";
          Anchor: @ColorControlButtonAnchor;
        }
      }
    }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        Label {
          Text: "Adamantite";
          Anchor: (Width: 96, Top: 18, Right: 14);
          Style: $C.@DefaultLabelStyle;
        }

        Group {
          Anchor: (Width: 72, Height: 72, Right: 16);
          Background: #1a2530;
          Padding: 4;

          Group {
            Anchor: (Full: 0);
            Background: #273443;
            Padding: 2;
          }

          ItemSlot #LockPreviewIcon {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            Visible: false;
          }
        }

        Label {
          Text: "Use the buttons to move one ingot between your inventory and the lock slot.";
          Style: (
            FontSize: 12,
            TextColor: $C.@ColorGrayCaption,
            VerticalAlignment: Center,
            Wrap: true
          );
          Anchor: (Top: 8, Width: 300);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        Group {
          Anchor: (Width: 96, Right: 14);
        }

        $C.@TextButton #InsertAdamantite {
          Text: "Insert";
          Anchor: (Width: 100, Right: 10);
        }

        $C.@TextButton #RemoveAdamantite {
          Text: "Remove";
          Anchor: (Width: 100);
        }
      }

      Label {
        Text: "Closing this window saves the selected color code and if the Adamantite Ingot is present to allow for a private network combo.";
        Style: (
          FontSize: 12,
          TextColor: $C.@ColorGrayCaption,
          Wrap: true
        );
      }
    }
  }
}

$C.@BackButton {}
