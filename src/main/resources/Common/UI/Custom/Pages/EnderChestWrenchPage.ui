$C = "../Common.ui";

@ColorNameStyle = (
  FontSize: 13,
  TextColor: $C.@ColorGrayCaption,
  VerticalAlignment: Center
);

@ColorSwatch = Group {
  Anchor: (Width: 58, Height: 36, Right: 8);
  Background: #f9fffe;
};

@PreviewLabelStyle = (
  FontSize: 12,
  TextColor: $C.@ColorGrayCaption,
  HorizontalAlignment: Center
);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = "Ender Chest";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label {
        Text: "Network owner";
        Style: $C.@DefaultLabelStyle;
        Anchor: (Bottom: 4);
      }

      Label #NetworkOwner {
        Style: (
          FontSize: 14,
          TextColor: $C.@ColorDefaultLabel,
          Wrap: true
        );
        Anchor: (Bottom: 16);
      }

      Label {
        Text: "Color code preview";
        Style: $C.@DefaultLabelStyle;
        Anchor: (Bottom: 8);
      }

      Group {
        LayoutMode: Center;
        Anchor: (Bottom: 18);

        Group {
          LayoutMode: Top;
          Anchor: (Width: 58, Right: 8);

          Label {
            Text: "Left";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          @ColorSwatch #LeftSwatch {}
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 58, Right: 8);

          Label {
            Text: "Center";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          @ColorSwatch #CenterSwatch {}
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 58, Right: 8);

          Label {
            Text: "Right";
            Style: @PreviewLabelStyle;
            Anchor: (Bottom: 4);
          }

          @ColorSwatch #RightSwatch {}
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Label {
          Text: "Left";
          Anchor: (Width: 96, Top: 6, Right: 14);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@DropdownBox #ColorOne {
          @Anchor = (Width: 190, Right: 16);
          DropdownEntry { Value: "0"; Text: "White"; }
          DropdownEntry { Value: "1"; Text: "Light Gray"; }
          DropdownEntry { Value: "2"; Text: "Gray"; }
          DropdownEntry { Value: "3"; Text: "Black"; }
          DropdownEntry { Value: "4"; Text: "Brown"; }
          DropdownEntry { Value: "5"; Text: "Red"; }
          DropdownEntry { Value: "6"; Text: "Orange"; }
          DropdownEntry { Value: "7"; Text: "Yellow"; }
          DropdownEntry { Value: "8"; Text: "Lime"; }
          DropdownEntry { Value: "9"; Text: "Green"; }
          DropdownEntry { Value: "10"; Text: "Cyan"; }
          DropdownEntry { Value: "11"; Text: "Light Blue"; }
          DropdownEntry { Value: "12"; Text: "Blue"; }
          DropdownEntry { Value: "13"; Text: "Purple"; }
          DropdownEntry { Value: "14"; Text: "Magenta"; }
          DropdownEntry { Value: "15"; Text: "Pink"; }
        }

        Label #ColorOneName {
          Style: @ColorNameStyle;
          Anchor: (Top: 6);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Label {
          Text: "Center";
          Anchor: (Width: 96, Top: 6, Right: 14);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@DropdownBox #ColorTwo {
          @Anchor = (Width: 190, Right: 16);
          DropdownEntry { Value: "0"; Text: "White"; }
          DropdownEntry { Value: "1"; Text: "Light Gray"; }
          DropdownEntry { Value: "2"; Text: "Gray"; }
          DropdownEntry { Value: "3"; Text: "Black"; }
          DropdownEntry { Value: "4"; Text: "Brown"; }
          DropdownEntry { Value: "5"; Text: "Red"; }
          DropdownEntry { Value: "6"; Text: "Orange"; }
          DropdownEntry { Value: "7"; Text: "Yellow"; }
          DropdownEntry { Value: "8"; Text: "Lime"; }
          DropdownEntry { Value: "9"; Text: "Green"; }
          DropdownEntry { Value: "10"; Text: "Cyan"; }
          DropdownEntry { Value: "11"; Text: "Light Blue"; }
          DropdownEntry { Value: "12"; Text: "Blue"; }
          DropdownEntry { Value: "13"; Text: "Purple"; }
          DropdownEntry { Value: "14"; Text: "Magenta"; }
          DropdownEntry { Value: "15"; Text: "Pink"; }
        }

        Label #ColorTwoName {
          Style: @ColorNameStyle;
          Anchor: (Top: 6);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Label {
          Text: "Right";
          Anchor: (Width: 96, Top: 6, Right: 14);
          Style: $C.@DefaultLabelStyle;
        }

        $C.@DropdownBox #ColorThree {
          @Anchor = (Width: 190, Right: 16);
          DropdownEntry { Value: "0"; Text: "White"; }
          DropdownEntry { Value: "1"; Text: "Light Gray"; }
          DropdownEntry { Value: "2"; Text: "Gray"; }
          DropdownEntry { Value: "3"; Text: "Black"; }
          DropdownEntry { Value: "4"; Text: "Brown"; }
          DropdownEntry { Value: "5"; Text: "Red"; }
          DropdownEntry { Value: "6"; Text: "Orange"; }
          DropdownEntry { Value: "7"; Text: "Yellow"; }
          DropdownEntry { Value: "8"; Text: "Lime"; }
          DropdownEntry { Value: "9"; Text: "Green"; }
          DropdownEntry { Value: "10"; Text: "Cyan"; }
          DropdownEntry { Value: "11"; Text: "Light Blue"; }
          DropdownEntry { Value: "12"; Text: "Blue"; }
          DropdownEntry { Value: "13"; Text: "Purple"; }
          DropdownEntry { Value: "14"; Text: "Magenta"; }
          DropdownEntry { Value: "15"; Text: "Pink"; }
        }

        Label #ColorThreeName {
          Style: @ColorNameStyle;
          Anchor: (Top: 6);
        }
      }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        Label {
          Text: "Adamantite";
          Anchor: (Width: 96, Top: 18, Right: 14);
          Style: $C.@DefaultLabelStyle;
        }

        Group {
          Anchor: (Width: 72, Height: 72, Right: 16);
          Background: #1a2530;
          Padding: 4;

          Group {
            Anchor: (Full: 0);
            Background: #273443;
            Padding: 2;
          }

          ItemSlot #LockPreviewIcon {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            Visible: false;
          }
        }

        Label {
          Text: "Use the buttons to move one ingot between your inventory and the lock slot.";
          Style: (
            FontSize: 12,
            TextColor: $C.@ColorGrayCaption,
            VerticalAlignment: Center,
            Wrap: true
          );
          Anchor: (Top: 8, Width: 300);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        Group {
          Anchor: (Width: 96, Right: 14);
        }

        $C.@TextButton #InsertAdamantite {
          Text: "Insert";
          Anchor: (Width: 100, Right: 10);
        }

        $C.@TextButton #RemoveAdamantite {
          Text: "Remove";
          Anchor: (Width: 100);
        }
      }

      Label {
        Text: "The color selectors are preview-only in this build. The adamantite slot still controls public/private mode.";
        Style: (
          FontSize: 12,
          TextColor: $C.@ColorGrayCaption,
          Wrap: true
        );
      }
    }
  }
}

$C.@BackButton {}
